@model List<ApplicationUser>
@{
    var roles = (Dictionary<string, string>)ViewBag.Roles;
}

<h2>Users</h2>
<table>
    <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Actions</th>
    </tr>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td>@roles[user.Id]</td>
            <td>
                <a asp-action="Edit" asp-route-id="@user.Id">Change Role</a>
                <a asp-action="Delete" asp-route-id="@user.Id">Delete</a>
            </td>
        </tr>
    }
</table>
