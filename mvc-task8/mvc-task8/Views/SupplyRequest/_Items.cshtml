@model List<RequestItem>

@if (Model.Count == 0)
{
    <p>There are no products to request.</p>
}
else
{
    <div asp-validation-summary="All"></div>
    <table>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Available</th>
            <th>Quantity to request</th>
        </tr>
        @for (int i = 0; i < Model.Count; i++)
        {
            if (Model[i].Product == null)
            {
                continue;
            }
            <tr>
                <td>@Model[i].Product.Name</td>
                <td>@Model[i].Product.Price.ToString("0.00")</td>
                <td>@Model[i].Product.Quantity</td>
                <td>
                    <input type="hidden" name="items[@i].ProductId" value="@Model[i].ProductId" />
                    <input type="number" name="items[@i].Quantity" value="@Model[i].Quantity" min="0" aria-label="@Model[i].Product.Name quantity" />
                </td>
            </tr>
        }
    </table>
    <button type="submit">Save Request</button>
}
